{
  "version": "0.2",
  "language": "en",
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./project-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": ["project-words", "en_US", "softwareTerms", "python"],
  "ignorePaths": [
    "node_modules/**",
    ".git/**",
    "docs/figures/*.svg",
    "assets/**",
    "LICENSE",
    "project-words.txt",
    "cspell.json"
  ],
  "ignoreRegExpList": [
    "/#[0-9A-Fa-f]{3,8}\\b/",
    "/\\]\\([^)]*\\)/",
    "/`[^`]*`/",
    "/```[\\s\\S]*?```/"
  ],
  "allowCompoundWords": true
}
