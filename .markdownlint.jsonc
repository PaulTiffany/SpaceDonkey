{
  // Not every document starts with an H1. CLAUDE.md opens with the @AGENTS.md
  // import that Claude Code requires on the first line, the pull request
  // template opens at H2 by design, and the repository README is a banner
  // image. None of these should grow a heading to satisfy a linter.
  "MD041": false,

  // Line length is prettier's job. Enforcing it here as well produces
  // conflicting fixes between the two tools.
  "MD013": false,

  // Duplicate headings are fine when nested under different parents.
  "MD024": { "siblings_only": true },

  // Inline HTML is needed for figure embeds, centred headers and <sub> notes.
  "MD033": false,

  // Bare URLs are caught by the link checker instead.
  "MD034": false,

  // Trailing punctuation in headings: allow question marks, since several
  // section headings here are genuine questions.
  "MD026": { "punctuation": ".,;:!" }
}
